*.log
dev.log
server.log

# Skills / IDE / sandbox internals
local-*
.claude
.z-ai-config
/skills/
.zscripts/
tests/

# database (SQLite local - los datos se exportan a public/data/)
db/*.db
db/*.db-journal

# worklog interno (opcional - comenta la línea si quieres commitearlo)
worklog.md
