# URL de la base de datos SQLite (local, solo dev)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Token del panel de administración (cámbialo por uno seguro en producción)
# Solo se usa en dev - el admin no funciona en el sitio estático deployado
ADMIN_TOKEN=admin-directorio-2026

# (Opcional) Token expuesto al cliente para login del admin en dev
NEXT_PUBLIC_ADMIN_TOKEN=admin-directorio-2026

# Flag para build estático (Cloudflare)
# BUILD_STATIC=1 → genera ./out/ con next.config.ts output:'export'
# No definir en dev normal
# BUILD_STATIC=1
