# Headers para Cloudflare Pages
# Evita que los JSON se cacheen para que los cambios se reflejen inmediatamente

# JSON de datos: no cache (siempre frescos)
/data/*
  Cache-Control: no-cache, no-store, must-revalidate

# HTML: no cache (para que cambios en el código se vean rápido)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# Archivos estáticos de Next.js (con hash): cache largo (son inmutables)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes locales: cache moderado (1 hora)
/images/*
  Cache-Control: public, max-age=3600
